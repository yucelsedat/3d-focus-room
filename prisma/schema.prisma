generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model Room {
  id           String         @id
  name         String
  roomType     String         @default("room")
  coverImage   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastActiveAt DateTime       @default(now())
  parentId     String?
  doors        Door[]
  floor        Floor?
  media        Media[]
  parent       Room?          @relation("RoomTree", fields: [parentId], references: [id])
  children     Room[]         @relation("RoomTree")
  categories   RoomCategory[]
  specialDoors SpecialDoor[]  @relation("SpecialDoorSource")
  targetedBy   SpecialDoor[]  @relation("SpecialDoorTarget")
  roomLinks    RoomLink[]     @relation("RoomLinkSource")
  linkedBy     RoomLink[]     @relation("RoomLinkTarget")
}

model Media {
  id       BigInt  @id
  roomId   String
  tileId   String
  type     String
  url      String?
  content  String?
  width    Float
  height   Float
  posX     Float
  posY     Float
  posZ     Float
  rotX     Float
  rotY     Float
  rotZ     Float
  rotOrder String  @default("XYZ")
  // Sync-kopya grubu: aynı değeri taşıyan canvas'lar içerik (items/bg) paylaşır
  syncGroupId String?
  room     Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([syncGroupId])
}

model Door {
  id     Int    @id @default(autoincrement())
  roomId String
  doorId Int
  layer  Int    @default(0) // 0=iç duvar, 1=1. bahçe duvarı (±30), 2=2. bahçe duvarı (±40)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, doorId, layer])
}

model Floor {
  roomId  String @id
  texture String @default("zemin.jpg")
  room    Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Category {
  id    Int            @id @default(autoincrement())
  name  String         @unique
  rooms RoomCategory[]
}

model RoomCategory {
  roomId     String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, categoryId])
}

model SpecialDoor {
  id           Int    @id @default(autoincrement())
  roomId       String
  anchorId     Int
  targetRoomId String
  layer        Int    @default(0) // 0=iç duvar, 1=1. bahçe duvarı (±30), 2=2. bahçe duvarı (±40)
  room         Room   @relation("SpecialDoorSource", fields: [roomId], references: [id], onDelete: Cascade)
  target       Room   @relation("SpecialDoorTarget", fields: [targetRoomId], references: [id], onDelete: Cascade)

  @@unique([roomId, anchorId, layer])
}

// Bağlantılı odalar: özel kapının aksine parent/child hiyerarşisi kurmaz, iki odayı
// eşit düzeyde birbirine bağlar. Bir oda birden çok odaya bağlanabilir. Her satır bir
// odadaki bağlantı kapısını (anchorId + layer) ve bağlı olduğu odayı tutar; karşı oda
// da kapı açarsa ters yönde ikinci bir satır oluşur.
model RoomLink {
  id           Int    @id @default(autoincrement())
  roomId       String
  anchorId     Int
  targetRoomId String
  layer        Int    @default(0) // 0=iç duvar, 1=1. bahçe duvarı (±30), 2=2. bahçe duvarı (±40)
  room         Room   @relation("RoomLinkSource", fields: [roomId], references: [id], onDelete: Cascade)
  target       Room   @relation("RoomLinkTarget", fields: [targetRoomId], references: [id], onDelete: Cascade)

  @@unique([roomId, anchorId, layer])
}

// Oda Defteri: B tuşuyla açılan defter, en üstteki kök odaya aittir ve o ağacın
// tüm alt odalarında ortaktır. content = JSON doküman (src/utils/notebookModel.js).
// Bilinçli olarak FK yok: kök cascade'siz silinince satırlar çocuk ağaçlara
// dağıtılır (server.js reconcileNotebooks) — cascade defteri anında silerdi.
// rev: iyimser eşzamanlılık (PUT eski rev ile gelirse 409).
model RoomNotebook {
  rootRoomId String   @id
  content    String
  rev        Int      @default(0)
  // Kitaplık kartı için; null → kök odanın adı / kapaksız
  name       String?
  coverUrl   String?
  updatedAt  DateTime @updatedAt
}

// Kitaplık: odaya bağlı olmayan defter. Canvas'taki defter kartı bunu gösterir,
// karttan "elime al" denince B tuşu bu defteri açar. content = oda defteriyle
// aynı JSON doküman (src/utils/notebookModel.js); rev aynı iyimser eşzamanlılık.
model Notebook {
  id        String   @id
  name      String
  coverUrl  String?
  content   String
  rev       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Timeline: /timeline sayfasındaki ölçekli zaman ekseni üzerinde sonsuz canvas.
// content = JSON doküman { items, bg, view } (src/utils/timelineModel.js);
// öğeler canvas tile ile aynı şemayı paylaşır. rev: iyimser eşzamanlılık
// (PUT eski rev ile gelirse 409) — iki sekmede açık timeline birbirini ezmesin.
model Timeline {
  id        String   @id
  name      String
  content   String
  rev       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Kitaplık (all-books): Seyir Defteri'nin web kopyası, ana sayfa ──────────
// Alanlar mobil uygulamanın SQLite şemasıyla aynı (snake_case API, server/library.js).

// Kitaplığın sekmeleri. id 1 = "Genel": hep vardır, silinmez, adı değişmez.
model ShelfCategory {
  id        Int      @id @default(autoincrement())
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

// Rafta duran defter. kind: agenda | notes | pdf; binding: band | spiral | file;
// paper: ruled | oxford | plain | grid | dot | a4 | letter. shelf/position: kategorisinin
// raflarındaki yeri (0 en üst raf, soldan sağa).
model ShelfBook {
  id          Int      @id @default(autoincrement())
  title       String
  color       String   @default("ink")
  kind        String   @default("pdf")
  binding     String   @default("file")
  paper       String   @default("a4")
  year        Int?
  weeklyPages Int      @default(1)
  monthGoals  Int      @default(1)
  monthReview Int      @default(1)
  habits      String   @default("none")
  pageCount   Int      @default(10)
  categoryId  Int      @default(1)
  shelf       Int      @default(0)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([categoryId, shelf, position])
}

// Sayfadaki blok (mobilde sheet_notes). kind 'page' + ref = sayfa numarası (1'den).
// content: Markdown + U+FFFC ile gömülü ekler; highlights/inks/times: lib/marks biçimi.
model ShelfNote {
  id         Int      @id @default(autoincrement())
  bookId     Int
  kind       String   @default("page")
  ref        Int
  content    String   @default("")
  highlights String   @default("")
  inks       String   @default("")
  times      String   @default("")
  time       String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([bookId, kind, ref])
}

// Not defteri / PDF sayfasının başlığı; başlık yazılmamış sayfanın satırı yoktur
model ShelfPageTitle {
  bookId Int
  ref    Int
  title  String

  @@id([bookId, ref])
}

// Sayfaya konan ayraç (mobilde favorites). kind 'page' + pageId = sayfa numarası.
model ShelfFavorite {
  id        Int      @id @default(autoincrement())
  bookId    Int
  kind      String
  pageId    Int
  createdAt DateTime @default(now())

  @@unique([bookId, kind, pageId])
}

// Sayfanın üstüne elle çizilen çizgiler (mobilde drawings). strokes: lib/drawing JSON'u.
model ShelfDrawing {
  id        Int      @id @default(autoincrement())
  bookId    Int
  kind      String
  pageId    Int
  strokes   String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([bookId, kind, pageId])
}
