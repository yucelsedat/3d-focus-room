generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model Room {
  id           String         @id
  name         String
  roomType     String         @default("room")
  coverImage   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastActiveAt DateTime       @default(now())
  parentId     String?
  doors        Door[]
  floor        Floor?
  media        Media[]
  parent       Room?          @relation("RoomTree", fields: [parentId], references: [id])
  children     Room[]         @relation("RoomTree")
  categories   RoomCategory[]
  specialDoors SpecialDoor[]  @relation("SpecialDoorSource")
  targetedBy   SpecialDoor[]  @relation("SpecialDoorTarget")
  roomLinks    RoomLink[]     @relation("RoomLinkSource")
  linkedBy     RoomLink[]     @relation("RoomLinkTarget")
}

model Media {
  id       BigInt  @id
  roomId   String
  tileId   String
  type     String
  url      String?
  content  String?
  width    Float
  height   Float
  posX     Float
  posY     Float
  posZ     Float
  rotX     Float
  rotY     Float
  rotZ     Float
  rotOrder String  @default("XYZ")
  room     Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Door {
  id     Int    @id @default(autoincrement())
  roomId String
  doorId Int
  layer  Int    @default(0) // 0=iç duvar, 1=1. bahçe duvarı (±30), 2=2. bahçe duvarı (±40)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, doorId, layer])
}

model Floor {
  roomId  String @id
  texture String @default("zemin.jpg")
  room    Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Category {
  id    Int            @id @default(autoincrement())
  name  String         @unique
  rooms RoomCategory[]
}

model RoomCategory {
  roomId     String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, categoryId])
}

model SpecialDoor {
  id           Int    @id @default(autoincrement())
  roomId       String
  anchorId     Int
  targetRoomId String
  layer        Int    @default(0) // 0=iç duvar, 1=1. bahçe duvarı (±30), 2=2. bahçe duvarı (±40)
  room         Room   @relation("SpecialDoorSource", fields: [roomId], references: [id], onDelete: Cascade)
  target       Room   @relation("SpecialDoorTarget", fields: [targetRoomId], references: [id], onDelete: Cascade)

  @@unique([roomId, anchorId, layer])
}

// Bağlantılı odalar: özel kapının aksine parent/child hiyerarşisi kurmaz, iki odayı
// eşit düzeyde birbirine bağlar. Bir oda birden çok odaya bağlanabilir. Her satır bir
// odadaki bağlantı kapısını (anchorId + layer) ve bağlı olduğu odayı tutar; karşı oda
// da kapı açarsa ters yönde ikinci bir satır oluşur.
model RoomLink {
  id           Int    @id @default(autoincrement())
  roomId       String
  anchorId     Int
  targetRoomId String
  layer        Int    @default(0) // 0=iç duvar, 1=1. bahçe duvarı (±30), 2=2. bahçe duvarı (±40)
  room         Room   @relation("RoomLinkSource", fields: [roomId], references: [id], onDelete: Cascade)
  target       Room   @relation("RoomLinkTarget", fields: [targetRoomId], references: [id], onDelete: Cascade)

  @@unique([roomId, anchorId, layer])
}
